# Copie este arquivo para ".env" e preencha os valores.

# Chave da API da Anthropic (obrigatória para o chat com IA).
# Crie a sua em: https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=

# Modelo da IA. Padrão: claude-opus-4-8 (melhor qualidade).
# Para gastar menos, você pode trocar por: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# Porta do servidor
PORT=3001

# Pasta onde o banco de dados é salvo (deixe assim para uso local)
DATA_DIR=./data
